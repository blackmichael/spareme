{
  "name": "spare-me-bowling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:brand",
    "dev": "vite",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:brand:check": "node scripts/generate-brand-assets.mjs --check",
    "build": "npm run generate:brand && tsc -b && vite build",
    "pretest": "npm run generate:brand:check",
    "test": "vitest run",
    "pretypecheck": "npm run generate:brand:check",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "^26.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fontkit": "^2.0.4",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
